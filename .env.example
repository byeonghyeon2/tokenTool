# Workspace paths
WORKSPACE_ROOT=C:\Users\Administrator\Documents\Codex\2026-07-15\files-mentioned-by-the-user-txt\work\AI-DEV-WORKSPACE
PROJECTS_ROOT=C:\Users\Administrator\Documents\Codex\2026-07-15\files-mentioned-by-the-user-txt\work\AI-DEV-WORKSPACE\projects

# MySQL / Prisma
# Leave empty when using only file scanning and UI-only flows.
# Example:
# DATABASE_URL=mysql://ai_dev_user:password@127.0.0.1:3306/ai_dev_workspace
DATABASE_URL=

# Codex execution
# mock: generate local records without invoking Codex CLI
# cli: invoke the configured Codex command when CODEX_CLI_ENABLED=true
CODEX_PROVIDER=mock
CODEX_COMMAND=codex
CODEX_ARGS_JSON=[]
CODEX_CLI_ENABLED=false

# Timeouts
CODEX_TIMEOUT_MS=600000
PROJECT_COMMAND_TIMEOUT_MS=120000

# Logging
LOG_LEVEL=info
